{
  "layer": "top",
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock#time"],
  "modules-right": [
    "custom/music",
    "custom/weather",
    "clock#date",
    "network",
    "custom/warp",
    "custom/tmux",
    "custom/claude",
    "cpu",
    "memory",
    "pulseaudio",
  ],

  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "format-icons": {
      "1": "",
      "2": "",
      "3": "",
      "4": "",
      "5": "",
      //"urgent": "",
      //"active": "",
      "default": "",
    },
    "sort-by-number": true,
    "persistent-workspaces": {
      "*": 5,
    },
  },

  "pulseaudio": {
    "tooltip": false,
    "scroll-step": 5,
    "format": "{icon} {volume}%",
    "format-muted": "{icon} {volume}%",

    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "format-icons": {
      "default": ["", "", ""],
    },
  },

  "network": {
    "tooltip": false,
    "format-wifi": "  {essid}",
    "format-ethernet": "",
  },

  "clock#time": {
    "format": "<span></span> {:%H:%M}",
    "tooltip": false,
    "interval": 60,
  },

  "custom/weather": {
    "interval": 300,
    "format": "{}",
    "exec": "~/.config/waybar/scripts/get-weather.sh",
    "return-type": "plain",
    "tooltip": false,
  },

  "clock#date": {
    "format": "<span></span> {:%d %a, %B}",
    "interval": 60,
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "right",
      "first-day-of-week": 1,
      "iso8601": true,
      "on-scroll": 1,
      "format": {
        "months": "<span color='#82aaff'><b>{}</b></span>",
        "days": "<span color='#c8d3f5'>{}</span>",
        "weeks": "<span color='#636da6'>W{}</span>",
        "weekdays": "<span color='#ffc777'><b>{}</b></span>",
        "today": "<span background='#86e1fc' color='#222436'><b>{}</b></span>",
      },
    },
    "actions": {
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down",
      "on-click-right": "shift_reset",
    },
  },

  "custom/warp": {
    "exec": "~/.config/waybar/scripts/warp-status.sh",
    "return-type": "json",
    "interval": 5,
    "signal": 10,
    "on-click": "~/.config/waybar/scripts/warp-toggle.sh",
    "tooltip": true,
  },

  "custom/tmux": {
    "exec": "~/.config/waybar/scripts/tmux-sessions.sh",
    "return-type": "json",
    "interval": 3600,
    "signal": 8,
    "on-click": "~/.config/waybar/scripts/tmux-kill.sh",
    "tooltip": true,
  },

  "custom/claude": {
    "exec": "~/.config/waybar/scripts/claude-usage.sh",
    "return-type": "json",
    "interval": 600,
    "signal": 9,
    "on-click": "~/.config/waybar/scripts/claude-usage-refresh.sh",
    "tooltip": true,
  },

  "cpu": {
    "interval": 15,
    "format": " {}%",
    "max-length": 10,
  },

  "memory": {
    "interval": 30,
    "format": " {}%",
    "max-length": 10,
  },
}
