# ===========================================
# SSH Config - Managed in config76/arch/.ssh
# ===========================================

# -------------------------------------------
# PERSONAL
# -------------------------------------------

# Host my-vps
#     HostName <your-server-ip>
#     Port 22
#     User <username>
#     IdentityFile ~/.ssh/id_ed25519

# Host github.com
#     HostName github.com
#     User git
#     IdentityFile ~/.ssh/id_ed25519

# -------------------------------------------
# DEFAULTS
# -------------------------------------------

Host *
    AddKeysToAgent yes
    IdentitiesOnly yes
    ServerAliveInterval 60
    ServerAliveCountMax 3
